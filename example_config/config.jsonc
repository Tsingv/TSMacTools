// Example TSMacTools configuration.
// Copy this directory to my_config for local use, then keep my_config untracked.
// The app reads ~/.config/tsmactool/config.jsonc; in this repo that symlink points to my_config.
{
  // macOS application identifiers and window filtering defaults.
  "application": {
    "finderBundleIdentifier": "com.apple.finder", // Used by the Finder toggle action.
    "ignoredWindowApplicationNames": [ // Apps ignored by the native window switcher.
      "Dock",
      "SystemUIServer",
      "Window Server"
    ],
    "terminalBundleIdentifier": "net.kovidgoyal.kitty" // Used by the terminal toggle action.
  },

  // Python executable used to run configured script functions.
  "scripting": {
    "pythonPath": "/Users/clearain/.venv/bin/python"
  },

  // Global hotkeys. Each binding requires at least one modifier. runScript loads path,
  // injects config/input_text/nativewindow/window, then calls function.
  "hotkeys": [
    {
      "action": {
        "interfaceName": "focusedWindowInfo",
        "kind": "callInterface"
      },
      "key": ".",
      "modifiers": [
        "ctrl",
        "cmd"
      ]
    },
    {
      "action": {
        "kind": "focusApplication",
        "path": "/Applications/WeChat.app"
      },
      "key": "W",
      "modifiers": [
        "alt"
      ]
    },
    {
      "action": {
        "kind": "focusApplication",
        "path": "/Applications/Discord.app"
      },
      "key": "O",
      "modifiers": [
        "alt"
      ]
    },
    {
      "action": {
        "kind": "focusApplication",
        "path": "/Applications/Lark.app"
      },
      "key": "F",
      "modifiers": [
        "alt"
      ]
    },
    {
      "action": {
        "kind": "focusApplication",
        "path": "/Applications/Google Chrome.app"
      },
      "key": "C",
      "modifiers": [
        "alt"
      ]
    },
    {
      "action": {
        "kind": "focusApplication",
        "path": "/Applications/SiYuan.app"
      },
      "key": "R",
      "modifiers": [
        "alt"
      ]
    },
    {
      "action": {
        "kind": "focusApplication",
        "path": "/Applications/Microsoft Outlook.app"
      },
      "key": "M",
      "modifiers": [
        "alt"
      ]
    },
    {
      "action": {
        "kind": "focusApplication",
        "path": "/Applications/QQ.app"
      },
      "key": "Q",
      "modifiers": [
        "alt"
      ]
    },
    {
      "action": {
        "kind": "focusApplication",
        "path": "/Applications/Visual Studio Code.app"
      },
      "key": "V",
      "modifiers": [
        "alt"
      ]
    },
    {
      "action": {
        "kind": "focusApplication",
        "path": "/Applications/Zotero.app"
      },
      "key": "Z",
      "modifiers": [
        "alt"
      ]
    },
    {
      "action": {
        "kind": "focusApplication",
        "path": "/Applications/Cherry Studio.app"
      },
      "key": "X",
      "modifiers": [
        "alt"
      ]
    },
    {
      "action": {
        "function": "main",
        "input": "selectedText",
        "kind": "runScript",
        "nativeWindowID": "translate",
        "path": "scripts/translate_selection.py"
      },
      "key": "S",
      "modifiers": [
        "alt"
      ]
    },
    {
      "action": {
        "bundleIdentifier": "com.apple.finder",
        "kind": "toggleFinder" // From other apps: focus recent Finder. In Finder: raise Home, or create a new Home window when already on Home.
      },
      "key": "E",
      "modifiers": [
        "alt"
      ]
    },
    {
      "action": {
        "bundleIdentifier": "net.kovidgoyal.kitty",
        "kind": "toggleTerminal"
      },
      "key": "D",
      "modifiers": [
        "cmd"
      ]
    },
    {
      "action": {
        "interfaceName": "reloadConfiguration",
        "kind": "callInterface"
      },
      "key": "R",
      "modifiers": [
        "cmd",
        "alt",
        "ctrl"
      ]
    }
  ],

  // Mouse-wheel smoothing. Trackpad/Magic Mouse gestures and already-continuous remote-desktop
  // events bypass this path by default; Logitech Options wheel metadata is treated as mouse input.
  // A restarted display link passes input through until that run delivers a real frame. macOS 26
  // routes marked frames by pointer location; clicking a mouse button cancels the remaining tail.
  "scroll": {
    "enabled": true,
    "preset": "balanced", // "precise", "balanced", "fluid", "glide", or "custom".
    "smoothVertical": true,
    "smoothHorizontal": true,
    "reverseVertical": false,
    "reverseHorizontal": false,
    "excludeTrackpad": true,
    "tuning": { // Used directly by "custom"; choosing another preset replaces these values in Settings.
      "step": 24.0, // Normalized wheel step, clamped to 1...120.
      "speed": 1.55, // Output multiplier, clamped to 0.20...6.
      "duration": 0.36, // Smoothing tail in seconds, clamped to 0.08...1.50.
      "acceleration": 0.28, // Burst acceleration, clamped to 0...1.
      "deadZone": 0.10 // Stop threshold, clamped to 0.01...2.
    }
  },

  // Native Command+Tab style window switcher settings.
  "windowSwitcher": {
    "commandTabBehavior": "most-recent-window", // Reserved current strategy identifier; alternate strategies are not implemented yet.
    "debug": true,
    "enabled": true,
    "followFocusedScreen": true, // Centers the overlay on the selected Accessibility window's display.
    "height": 420, // Settings accepts 120...1200; runtime also guards malformed external values.
    "maxVisibleRows": 9, // Settings accepts 1...50.
    "sameApplicationBehavior": "cycle-same-application-windows", // Reserved current strategy identifier.
    "width": 760 // Settings accepts 320...1600; runtime also guards malformed external values.
  },

  // Translation settings consumed by scripts/translate_selection.py.
  "translation": {
    "provider": "google_web", // "google_web" uses the unofficial web endpoint; "google" uses Cloud Translation; "llm" uses the chat-completions endpoint below.
    "apiKey": "", // API key for the chat-completions-compatible LLM endpoint. Leave blank in examples.
    "copyKeystrokeDelay": 0.18, // Delay after Command+C before reading selected text from the pasteboard.
    "enabled": true, // Disables the built-in selected-text translation action when false.
    "googleApiKey": "", // Google Cloud Translation API key. Leave blank in examples.
    "googleSourceLanguage": "auto", // "auto" lets Google detect the source language.
    "googleTargetLanguage": "zh-CN", // Target used for non-Chinese selected text.
    "googleTargetLanguageForChinese": "en", // Target used when selected text contains Chinese.
    "endpoint": "http://127.0.0.1:8787/v1/chat/completions", // Chat completions endpoint URL.
    "model": "qwen/qwen3.6-27b", // Model name sent to the endpoint.
    "normalizePDFLineBreaks": true, // Joins common PDF hard-wrapped lines before translation while preserving blank paragraphs and lists.
    "contextWindowTokens": 262144, // Model context window. Used for a preflight selected-text budget warning.
    "outputTokenLimit": 2048, // Desired output budget sent as max_completion_tokens after request-limit clamping.
    "requestTokenLimit": 8000, // Service-tier request budget for prompt plus max_completion_tokens. Set 0 to disable.
    "thinkingEnabled": false, // Sends enable_thinking to disable or enable model reasoning when supported.
    "thinkingParameter": "include_reasoning", // For Groq/CLIProxyAPI, false hides reasoning output; use "enable_thinking" for Qwen-compatible endpoints.
    "nativeWindow": {
      "format": "markdown",
      "height": 620,
      "id": "translate",
      "pinByDefault": false,
      "title": "LLM Translate",
      "width": 720
    },
    "promptTemplate": "你是一个专业的英语翻译人员，尤其是知晓计算机领域的各种术语，接下来我会提供你一段文本，你需要如下操作：\n- 识别提供的文本，如果中文，翻译为地道的英文；如果是英文或其他语言，翻译为中文\n- 直接简短提示我是什么原始语言，翻译成了什么语言，随后换2行并跟上翻译后的文本，不要其他的多余内容\n- 不得增删任何内容，不得压缩内容，不要遗漏翻译任何内容\n---\n\n{{sourceText}}", // {{sourceText}} is replaced by selected text.
    "systemPrompt": "", // Optional system message.
    "temperature": 0.2 // Sampling temperature.
  }
}
